# ============================================================================
# WORDDROP — GIT ATTRIBUTES
# ============================================================================
# Normalizes line endings and configures Git LFS for large files.
# Documentation: https://git-scm.com/docs/gitattributes
# ============================================================================


# ============================================================================
# DEFAULT BEHAVIOR
# ============================================================================
# Auto-detect text files and normalize to LF on commit.
# On checkout, Git will convert to the native line ending of the OS.
# ============================================================================

* text=auto eol=lf


# ============================================================================
# TEXT FILES (force LF)
# ============================================================================
# Source code and config files should always use LF, regardless of OS.
# ============================================================================

*.html      text eol=lf
*.htm       text eol=lf
*.css       text eol=lf
*.scss      text eol=lf
*.sass      text eol=lf
*.less      text eol=lf
*.js        text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
*.jsx       text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.json      text eol=lf
*.jsonc     text eol=lf
*.xml       text eol=lf
*.svg       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
*.md        text eol=lf
*.markdown  text eol=lf
*.txt       text eol=lf
*.sql       text eol=lf
*.sh        text eol=lf
*.bash      text eol=lf
*.zsh       text eol=lf
*.fish      text eol=lf
*.env       text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf


# ============================================================================
# WINDOWS-SPECIFIC TEXT FILES (force CRLF)
# ============================================================================
# Batch and PowerShell scripts must use CRLF on Windows.
# ============================================================================

*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf


# ============================================================================
# BINARY FILES (no conversion)
# ============================================================================
# Never treat these as text — no line ending conversion, no diff.
# ============================================================================

# Images
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.avif      binary
*.ico       binary
*.bmp       binary
*.tiff      binary
*.tif       binary

# Fonts
*.ttf       binary
*.otf       binary
*.woff      binary
*.woff2     binary
*.eot       binary

# Audio
*.mp3       binary
*.wav       binary
*.ogg       binary
*.m4a       binary
*.flac      binary
*.aac       binary

# Video
*.mp4       binary
*.webm      binary
*.mov       binary
*.avi       binary
*.mkv       binary

# 3D models
*.glb       binary
*.gltf      binary
*.fbx       binary
*.obj       binary
*.blend     binary
*.stl       binary

# Archives
*.zip       binary
*.tar       binary
*.gz        binary
*.tgz       binary
*.rar       binary
*.7z        binary
*.bz2       binary
*.xz        binary

# Executables
*.exe       binary
*.dll       binary
*.so        binary
*.dylib     binary
*.bin       binary

# Documents
*.pdf       binary
*.doc       binary
*.docx      binary
*.xls       binary
*.xlsx      binary
*.ppt       binary
*.pptx      binary


# ============================================================================
# GIT LFS (LARGE FILE STORAGE)
# ============================================================================
# If you enable Git LFS, these files will be stored on the LFS server.
# To enable: git lfs install && git add .gitattributes
#
# Uncomment to enable:
# ============================================================================

# *.psd     filter=lfs diff=lfs merge=lfs -text
# *.ai      filter=lfs diff=lfs merge=lfs -text
# *.sketch  filter=lfs diff=lfs merge=lfs -text
# *.fig     filter=lfs diff=lfs merge=lfs -text
# *.mp4     filter=lfs diff=lfs merge=lfs -text
# *.mov     filter=lfs diff=lfs merge=lfs -text
# *.glb     filter=lfs diff=lfs merge=lfs -text
# *.gltf    filter=lfs diff=lfs merge=lfs -text


# ============================================================================
# DIFF BEHAVIOR
# ============================================================================
# Mark certain file types as "binary" for diff purposes.
# This prevents Git from showing garbage in diffs.
# ============================================================================

*.min.js    -diff -merge
*.min.css   -diff -merge
*.map       -diff -merge


# ============================================================================
# EXPORT-IGNORE
# ============================================================================
# Files that should not be included in `git archive`.
# ============================================================================

.gitignore          export-ignore
.gitattributes      export-ignore
.github/            export-ignore
docs/               export-ignore
*.md                export-ignore
