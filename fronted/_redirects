# Cloudflare Pages redirects — /verify/* URL'ni verify.html sahifasiga yo'naltirish
# Status 200 = URL o'zgarmaydi, faqat verify.html serverdan xizmat qiladi (SPA fallback)
# Bu esa verify.html'ga URL dan serialni JS bilan olib chizishga imkon beradi

/verify/*    /verify.html    200

# Jamoa taklif havolalari: /g/KOD -> community.html (URL o'zgarmaydi, kod JS orqali o'qiladi)
/g/*    /community.html    200

# SPA fallback — noma'lum URL'lar bosh sahifaga yo'naltirilsin (ixtiyoriy)
# /*    /index.html    200
