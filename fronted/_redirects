# ============================================================
# WORDDROP — CLOUDFLARE PAGES REDIRECTS
# ============================================================
# Status 200 = URL o'zgarmaydi (SPA fallback)
# Status 302 = vaqtinchalik yo'naltirish
# Status 404 = sahifa topilmadi
# ============================================================

# --- Sertifikat tekshiruvi ---
# /verify/ABC123 → verify.html (URL saqlanadi, JS serialni o'qiydi)
/verify/*         /verify.html    200

# --- Admin panelni yashirish ---
# Agar admin.html yuklangan bo'lsa — bosh sahifaga yo'naltirish
/admin.html       /               302
/admin/*          /               302

# --- Eski URL'lar uchun (agar kerak bo'lsa) ---
# /term.html → /terms.html (eski havolalar uchun)
/term.html        /terms.html     301

# --- SPA fallback ---
# Noma'lum URL'lar 404 sahifasiga
/*                /404.html       404
