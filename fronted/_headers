# ============================================================================
# WORDDROP — PROFESSIONAL SECURITY & CACHE HEADERS
# ============================================================================

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  
  # ==========================================================================
  # CONTENT SECURITY POLICY (CSP)
  # Bu qoida barcha tashqi resurslarga (Supabase, YouTube, CDN) ruxsat beradi
  # ==========================================================================
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://jgeycbyaoiybpudakgmk.supabase.co https://*.supabase.co https://*.googleusercontent.com https://*.githubusercontent.com; media-src 'self' blob: data: https://jgeycbyaoiybpudakgmk.supabase.co https://*.supabase.co; connect-src 'self' https://jgeycbyaoiybpudakgmk.supabase.co wss://jgeycbyaoiybpudakgmk.supabase.co https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://static.cloudflareinsights.com; frame-src 'self' https://www.youtube.com https://youtube.com https://player.vimeo.com; worker-src 'self' blob:;

# ============================================================================
# HTML FAYLLAR UCHUN (Keshni o'chirish - har doim yangi versiya yuklansin)
# ============================================================================
/*.html
  Cache-Control: no-cache, no-store, must-revalidate

/
  Cache-Control: no-cache, no-store, must-revalidate

# ============================================================================
# PWA UCHUN (Service Worker va Manifest keshda qolmasin)
# ============================================================================
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.json
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: application/manifest+json

# ============================================================================
# ADMIN PANEL UCHUN (Qidiruv botlari va keshni bloklash)
# ============================================================================
/admin.html
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store, no-cache, must-revalidate

# ============================================================================
# STATIK FAYLLAR UCHUN (Tezlik va kesh - 1 yil)
# ============================================================================
/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/*.mp3
  Cache-Control: public, max-age=31536000, immutable

/*.mp4
  Cache-Control: public, max-age=31536000, immutable

/*.glb
  Cache-Control: public, max-age=31536000, immutable
